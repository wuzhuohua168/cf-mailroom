{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Resource names identify this deployment; every instance chooses its own.
  "name": "mailroom",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Publish the workers.dev hostname. The worker itself enforces the
  // password gate (UI_PASSWORD secret) on every request, including static
  // assets — this instance cannot use Cloudflare Access (Zero Trust Free
  // requires billing info).
  // Preview URLs are separate hostnames, so keep them off.
  "workers_dev": true,
  "preview_urls": false,
  // Preserve per-instance WEB_ACCESS_TEAM_DOMAIN and WEB_ACCESS_AUD from
  // Worker Settings > Variables and Secrets. Missing values deny all API access.
  "keep_vars": true,
  "assets": {
    // Expose static assets as env.ASSETS so the worker can serve the SPA
    // itself after the password gate (required; without it env.ASSETS is
    // undefined and every non-API request 500s).
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Route everything through the worker first so the password gate also
    // covers the SPA shell and static assets (upstream only listed API/MCP
    // paths because it relied on Cloudflare Access at the edge).
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Resolve by name in the deploying Cloudflare account; no account-specific ID.
      // Manual setup must create the database before migrations (docs/deployment.md).
      "database_name": "mailroom",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // MCP OAuth clients, grants, and tokens. No ID: Wrangler creates the
      // namespace on first deploy and reuses it afterwards.
      "binding": "OAUTH_KV"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      // Sender domains must be onboarded to Email Service (dashboard > Email Service).
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DRAFT_QUEUE",
        "queue": "mailroom-drafts"
      },
      {
        // Declare the DLQ as a binding so template deployments provision it too.
        // The consumer below routes exhausted retries here; app code does not send to it.
        "binding": "DRAFT_DLQ",
        "queue": "mailroom-drafts-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "mailroom-drafts",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "mailroom-drafts-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
